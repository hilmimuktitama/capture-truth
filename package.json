{
  "name": "capture-truth",
  "version": "0.5.1",
  "description": "Capture already-exported operational material into provenance-preserving evidence packs.",
  "author": "hilmimuktitama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hilmimuktitama/capture-truth.git"
  },
  "bugs": {
    "url": "https://github.com/hilmimuktitama/capture-truth/issues"
  },
  "homepage": "https://github.com/hilmimuktitama/capture-truth#readme",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./adapters": "./src/adapters.js",
    "./capture": "./src/capture.js",
    "./contracts": "./src/contracts.js",
    "./mcp": "./src/mcp-tools.js"
  },
  "bin": {
    "capture-truth": "bin/capture-truth.js",
    "capture-truth-mcp": "src/mcp-server.js"
  },
  "files": [
    "bin",
    "docs",
    "src",
    "schemas",
    "examples",
    "references",
    "SKILL.md",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "markdown",
    "provenance",
    "source-capture",
    "evidence-capture"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check-syntax.js",
    "contracts:verify": "node scripts/contracts-verify.js",
    "eval": "node scripts/eval.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "engines": {
    "node": ">=22"
  }
}
